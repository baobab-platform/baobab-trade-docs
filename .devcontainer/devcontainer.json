{
  "name": "Baobab Trade Docs HYB-01",
  "dockerComposeFile": "compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/baobab-trade-docs",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "postCreateCommand": "bash scripts/hyb01-bootstrap.sh",
  "customizations": {
